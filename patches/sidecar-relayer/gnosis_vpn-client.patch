+/// How long the first payment may take before the attempt goes on without the hold. Below the exit's own
+/// wait for a deposit (3 minutes on the exit appliance), so a stuck payment does not also cost the session.
+const FIRST_PAYMENT_TIMEOUT: Duration = Duration::from_secs(150);
+/// A session the exit never asks to pay for (an exit that does not enforce payment) is not held.
+const NO_PAYMENT_REQUEST_AFTER: Duration = Duration::from_secs(10);
+/// From "the relayer accepted the deposit" to "the exit sees it": the indexer serves only blocks that are
+/// 3 confirmations (15 s) deep and the pool operator has to commit the note first. Measured in the lab:
+/// 20.6 to 21.5 s. `GNOSISVPN_PIX_CONFIRMATION_HOLD_SECS` overrides it for experiments.
+const CONFIRMATION_HOLD: Duration = Duration::from_secs(22);
+
+/// Opens the relayer side-car session; `None` when there is nothing to route or it cannot be opened.
+async fn open_relayer_sidecar(hopr: &Hopr, destination: &Destination, options: &Options) -> Option<std::net::SocketAddr> {
+    let surb = match surb_config_for(&options.surb_balancing.bridge) {
+        Ok(surb) => surb,
+        Err(error) => {
+            tracing::warn!(%error, "no SURB configuration for the relayer side-car session");
+            return None;
+        }
+    };
+    let cfg = HoprSessionClientConfig {
+        capabilities: options.sessions.bridge.capabilities,
+        forward_path: destination.routing,
+        return_path: destination.routing,
+        max_surbs_per_data_packet: surb.max_surbs_per_data_packet,
+        surb_management: surb.management,
+        flow_control: Some(FlowControlConfig::robust()),
+        ..Default::default()
+    };
+    match hopr.open_relayer_session(destination.address, cfg).await {
+        Ok(Some(listener)) => {
+            tracing::info!(%destination, %listener, "payment relayer goes through its own session");
+            Some(listener)
+        }
+        Ok(None) => None,
+        Err(error) => {
+            tracing::warn!(%error, "cannot open the relayer side-car session - payments use the ordinary route");
+            None
+        }
+    }
+}
+
+/// Waits until the first chunk of `session` is paid, then for the time the exit needs to see the payment.
+async fn await_first_payment(hopr: &Hopr, session: &SessionClientMetadata) -> Result<(), String> {
+    let Some(session_id) = session.active_clients.first() else {
+        return Err("the session has no id to follow its payment by".into());
+    };
+    let started = time::Instant::now();
+    tracing::info!(%session_id, "holding the tunnel back until the first payment is confirmed");
+    loop {
+        let stats = hopr.pix_chunks().stats(session_id, HoprBalance::zero());
+        if stats.chunks_failed > 0 {
+            return Err("the deposit failed".into());
+        }
+        if stats.chunks_paid > 0 {
+            break;
+        }
+        if stats.chunks_committed == 0 && started.elapsed() > NO_PAYMENT_REQUEST_AFTER {
+            tracing::info!(%session_id, "the exit asked for no payment - not holding");
+            return Ok(());
+        }
+        if started.elapsed() > FIRST_PAYMENT_TIMEOUT {
+            return Err(format!("no deposit made within {FIRST_PAYMENT_TIMEOUT:?}"));
+        }
+        time::sleep(Duration::from_millis(500)).await;
+    }
+    let paid_after = started.elapsed();
+    let hold = std::env::var("GNOSISVPN_PIX_CONFIRMATION_HOLD_SECS")
+        .ok()
+        .and_then(|secs| secs.parse().ok())
+        .map(Duration::from_secs)
+        .unwrap_or(CONFIRMATION_HOLD);
+    tracing::info!(%session_id, ?paid_after, ?hold, "first deposit made - waiting for the exit to see it");
+    time::sleep(hold).await;
+    tracing::info!(%session_id, held = ?started.elapsed(), "first payment confirmed - attaching the tunnel");
+    Ok(())
+}
+
 /// A dead probe listener fails fast so `core` replaces the probe and restarts the attempt.
 async fn register(
     options: &Options,
